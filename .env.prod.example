# The personal production instance (scripts/prod.sh). Copied to .env.prod on the first `scripts/prod.sh up`, with
# DB_PASSWORD and APP_ENCRYPTION_KEY generated. Never commit .env.prod; back it up together with the database backups:
# without APP_ENCRYPTION_KEY the stored mailbox tokens and TOTP secrets cannot be decrypted.
# No quotes around values.

# --- Where it runs ------------------------------------------------------------
# The web app: http://127.0.0.1:${WEB_PORT}. Use 127.0.0.1, not localhost: dev runs on localhost, and browsers keep
# cookies per host name (not per port), so the two would log each other out on the same name.
WEB_PORT=3001

# --- Database (inside the compose project only, never published) -------------
DB_NAME=contor
DB_USERNAME=contor
DB_PASSWORD=

# --- Backend --------------------------------------------------------------------
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_VERSION=1
APP_SECURE_COOKIES=false
APP_SESSION_IDLE_TIMEOUT=30m
APP_SESSION_ABSOLUTE_TIMEOUT=12h

# --- Local AI (Ollama on the host, reached through the relay in compose.yml) ----
AI_MODEL_ROUTING=qwen3.5:9b
AI_MODEL_EXTRACTION=qwen3.5:9b
AI_MODEL_EMBEDDING=nomic-embed-text
AI_TIMEZONE=Europe/Berlin
AI_PROCESSING_ENABLED=true
AI_PROCESSING_INTERVAL=2m
AI_PROCESSING_BATCH_SIZE=20
OLLAMA_TIMEOUT=5m
OLLAMA_NUM_CTX=16384
OLLAMA_KEEP_ALIVE=30m

# --- Mail (see README, "Mail setup"; register the callback below with Microsoft / Google) ---
APP_WEB_URL=http://127.0.0.1:3001
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
MSGRAPH_TENANT_ID=common
MSGRAPH_REDIRECT_URI=http://localhost:3001/api/mail/accounts/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3001/api/mail/accounts/callback
MAIL_SYNC_INTERVAL=5m
