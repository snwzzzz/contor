{
  "name": "contor-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:api": "orval",
    "predev": "npm run generate:api",
    "dev": "next dev",
    "prebuild": "npm run generate:api",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "npm run generate:api && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest": "npm run generate:api",
    "test:e2e": "playwright test",
    "test:e2e:prod": "CONTOR_API_URL=http://127.0.0.1:18080 npm run build && E2E_PROD=true playwright test",
    "screenshots": "E2E_SCREENSHOTS=true playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.2",
    "orval": "^8.40.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "engines": {
    "node": ">=24"
  }
}
