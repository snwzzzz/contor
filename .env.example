# Copy to .env and fill in. Never commit .env.
# Used by infra/docker-compose.yml (docker compose --env-file .env -f infra/docker-compose.yml up -d)
# and by the backend (read automatically when started from contor-api; no quotes around values).

# --- Database ---------------------------------------------------------------
DB_NAME=contor
DB_USERNAME=contor
DB_PASSWORD=change-me
DB_PORT=5432
DB_URL=jdbc:postgresql://127.0.0.1:5432/contor

# --- Backend (contor-api) ---------------------------------------------------
# Interface Spring binds to. Keep 127.0.0.1 unless you know why not.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
# Base64-encoded 256-bit key for encrypted columns (OAuth tokens, TOTP secrets). Required.
# Generate with: openssl rand -base64 32
# Losing it makes stored tokens/secrets unreadable; changing it requires re-encryption (rotation comes later).
APP_ENCRYPTION_KEY=
# Version prefix written into every encrypted value (v1:...). Only change when rotating keys.
APP_ENCRYPTION_KEY_VERSION=1
# Add the Secure flag to session/CSRF cookies. Set to true when contor is served over HTTPS.
APP_SECURE_COOKIES=false
# Session idle timeout and absolute lifetime (Spring duration syntax: 30m, 12h).
APP_SESSION_IDLE_TIMEOUT=30m
APP_SESSION_ABSOLUTE_TIMEOUT=12h

# --- Local AI (Ollama runs natively on the host and must stay bound to localhost; the backend refuses other hosts) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_MODEL_ROUTING=qwen3.5:9b
AI_MODEL_EXTRACTION=qwen3.5:9b
AI_MODEL_EMBEDDING=nomic-embed-text
# Time zone local times in emails are read in ("Friday 9:00"); the backend itself runs in UTC.
AI_TIMEZONE=Europe/Berlin
# Background analysis of new mail after the AI setup (enabled, pause between passes, emails per pass).
AI_PROCESSING_ENABLED=true
AI_PROCESSING_INTERVAL=2m
AI_PROCESSING_BATCH_SIZE=20
# Ollama call tuning: read timeout, context window (tokens; more needs more VRAM), how long the model stays loaded.
OLLAMA_TIMEOUT=5m
OLLAMA_NUM_CTX=16384
OLLAMA_KEEP_ALIVE=30m

# --- Microsoft Graph (Outlook mail sync) ------------------------------------
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
MSGRAPH_TENANT_ID=common
# Web app URL the browser returns to after connecting a mailbox.
APP_WEB_URL=http://localhost:3000
MSGRAPH_REDIRECT_URI=http://localhost:8080/api/mail/accounts/callback
MSGRAPH_SCOPES=Mail.Read,User.Read,Contacts.Read,offline_access
MAIL_SYNC_INTERVAL=5m

# --- Frontend (contor-web) --------------------------------------------------
# Where the Next.js server proxies /api/* to (server-side only, never exposed to the browser).
CONTOR_API_URL=http://127.0.0.1:8080


# --- Dev account (dev profile only) ------------------------------------------
# Login kept ready on every start of the dev backend: created as OWNER if missing, else password/lockout reset.
DEV_ACCOUNT_USERNAME=
DEV_ACCOUNT_EMAIL=
DEV_ACCOUNT_PASSWORD=
